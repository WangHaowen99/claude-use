# Claude Code provider secrets and defaults.
# Copy this file to ~/.claude-code-providers.env and fill in your API keys.
#   cp claude-code-providers.example.env ~/.claude-code-providers.env
#   chmod 600 ~/.claude-code-providers.env
#
# This file is sourced by claude-use.sh.

# Default provider (zhipu / deepseek / aliyun / aliyun-intl / aliyun-coding / anthropic)
CLAUDE_CODE_PROVIDER='zhipu'

# ── Zhipu BigModel (智谱 GLM) ──────────────────────────────
CLAUDE_CODE_ZHIPU_AUTH_TOKEN=''
CLAUDE_CODE_ZHIPU_BASE_URL='https://open.bigmodel.cn/api/anthropic'
CLAUDE_CODE_ZHIPU_MODEL='glm-5.1'

# ── DeepSeek ────────────────────────────────────────────────
CLAUDE_CODE_DEEPSEEK_AUTH_TOKEN=''
CLAUDE_CODE_DEEPSEEK_BASE_URL='https://api.deepseek.com/anthropic'
CLAUDE_CODE_DEEPSEEK_MODEL='deepseek-v4-pro[1m]'
CLAUDE_CODE_DEEPSEEK_DEFAULT_SONNET_MODEL='deepseek-v4-pro'
CLAUDE_CODE_DEEPSEEK_DEFAULT_HAIKU_MODEL='deepseek-v4-flash'

# ── Aliyun DashScope (阿里云百炼) ───────────────────────────
CLAUDE_CODE_ALIYUN_API_KEY=''
CLAUDE_CODE_ALIYUN_BASE_URL='https://dashscope.aliyuncs.com/apps/anthropic'
CLAUDE_CODE_ALIYUN_MODEL='qwen3.6-plus'
CLAUDE_CODE_ALIYUN_SMALL_FAST_MODEL='qwen3.6-flash'
CLAUDE_CODE_ALIYUN_DEFAULT_HAIKU_MODEL='qwen3.6-flash'
CLAUDE_CODE_ALIYUN_DEFAULT_SONNET_MODEL='qwen3.6-plus'
CLAUDE_CODE_ALIYUN_DEFAULT_OPUS_MODEL='qwen3.6-plus'
CLAUDE_CODE_ALIYUN_SUBAGENT_MODEL='qwen3.6-plus'

# ── Aliyun DashScope International ──────────────────────────
CLAUDE_CODE_ALIYUN_INTL_API_KEY=''
CLAUDE_CODE_ALIYUN_INTL_BASE_URL='https://dashscope-intl.aliyuncs.com/apps/anthropic'
CLAUDE_CODE_ALIYUN_INTL_MODEL='qwen3.6-plus'

# ── Aliyun Coding DashScope ─────────────────────────────────
CLAUDE_CODE_ALIYUN_CODING_AUTH_TOKEN=''
CLAUDE_CODE_ALIYUN_CODING_BASE_URL='https://coding.dashscope.aliyuncs.com/apps/anthropic'
CLAUDE_CODE_ALIYUN_CODING_MODEL='qwen3.6-plus'

# ── PackyCode ───────────────────────────────────────────────
CLAUDE_CODE_PACKYCODE_API_KEY=''
CLAUDE_CODE_PACKYCODE_BASE_URL='https://www.packyapi.com/v1'
CLAUDE_CODE_PACKYCODE_MODEL='claude-opus-4-7'

# ── Official Anthropic API ──────────────────────────────────
CLAUDE_CODE_ANTHROPIC_API_KEY=''
CLAUDE_CODE_ANTHROPIC_MODEL=''
